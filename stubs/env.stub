# ---------------------------------------------------------------------------
# Pasax — variabel inti (core)
#
# Cukup ini saja di .env. Seluruh perilaku keamanan lainnya (ambang
# auto-block, blokir instan, jendela waktu, durasi, tingkat ancaman,
# proteksi brute force login, retensi log, dan pengumuman) diatur dari
# dashboard Pasax → menu Pengaturan, tersimpan di database, dilengkapi
# nilai bawaan yang wajar. Kunci PASAX_* lama di luar daftar ini tetap
# dihargai sebagai override manual bila sudah ada, tetapi tidak wajib.
# ---------------------------------------------------------------------------

# Sakelar utama WAF: Aktifkan (true) atau nonaktifkan (false) seluruh inspeksi keamanan
PASAX_MONITOR_ENABLED=true

# Daftar putih IP yang tidak akan pernah diblokir (pisahkan dengan koma jika lebih dari satu).
# Wajib diisi IP admin/kantor agar pembaru tidak mengunci sendiri saat dashboard tak terjangkau.
PASAX_IP_WHITELIST=127.0.0.1,::1

# Sakelar pendaftaran middleware WAF otomatis ke HTTP Kernel (untuk host yg tidak menyunting
# kernel manual; pasax:install biasanya sudah menyuntikkannya — biarkan false agar tidak dobel)
PASAX_AUTO_REGISTER_MIDDLEWARE=false

# Rute REST API headless (/api/pasax/*): Set false jika aplikasi hanya menggunakan rute web biasa
PASAX_ROUTES_ENABLED=true

# Dashboard monitoring Blade murni (fitur visual pada /pasax, wajib login pengguna).
# Publikasikan tampilannya dengan: php artisan pasax:install --with-dashboard (atau --tag=plain-views)
PASAX_DASHBOARD_ENABLED=false
# Awalan URL dashboard monitoring (default: pasax) -> diakses pada /pasax
PASAX_DASHBOARD_PREFIX=pasax
# Kredensial autentikasi form login mandiri dashboard Pasax:
# Username untuk login ke dashboard (default: admin)
PASAX_DASHBOARD_USERNAME=admin
# Password default awal sebelum diganti dan disimpan ke database (default: Admin)
PASAX_DASHBOARD_PASSWORD=Admin
# URL acak sekali pakai: /pasax stabil 302 ke /pasax-{token}/ milik sesi tiap user.
# Token diputar setiap akses HTML sehingga reload selalu berubah
# (mis. /pasax-95856857476jdhjs5/logs lalu /pasax-634664873647jbdjshf/threat-map).
# Diisi otomatis oleh pasax:install saat dashboard dipasang; kosongkan (false) untuk prefix statis.
PASAX_DASHBOARD_ROTATING=true
# Rahasia penanda tangan token dashboard (dibuat otomatis saat install, jangan disebar).
# Hanya ditulis ke .env. Setelah clone/deploy baru: php artisan pasax:deploy (atau pasax:secret)
PASAX_DASHBOARD_SECRET=
# Panjang token acak (12-32, default 16) + masa tenggang URL lama (detik, default 120).
PASAX_DASHBOARD_TOKEN_LENGTH=16
PASAX_DASHBOARD_SINGLE_USE=true
PASAX_DASHBOARD_GRACE_SECONDS=120
# Batasi akses dashboard hanya untuk akun ber-role admin (default: false, cukup login)
PASAX_DASHBOARD_ADMIN_ONLY=false

# Pesan khusus + alamat bantuan yang tampil di halaman blokir 403 (opsional)
PASAX_SUPPORT_EMAIL=security@domain-anda.test

# ---------------------------------------------------------------------------
# Pasax Cloud SOC & Sentinel Fleet Monitoring
# ---------------------------------------------------------------------------
# Kunci lisensi langganan Pasax Cloud SOC (contoh: psk_live_...)
# Menggunakan APP_NAME dan APP_URL untuk registrasi armada & pemantauan terpusat.
PASAX_CLOUD_KEY=

# Pasax Sentinel Host Daemon (Unix Domain Socket IPC)
PASAX_SENTINEL_ENABLED=true
PASAX_SENTINEL_SOCKET=/run/pasax/agent.sock

