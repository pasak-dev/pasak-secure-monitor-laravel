includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
        - database
        - routes
        - tests
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Dynamic filesystem / runtime state checks
        - '#Negated boolean expression is always true.#'
        - '#Instanceof between .*Request and .*Request will always evaluate to true.#'
        # Larastan narrows view()->exists() based on the host's published views,
        # so its result is environment-dependent (true when the host has published
        # the view, false on a clean checkout such as CI).
        - '#Factory::exists\(\) with .* will always evaluate to (true|false)#'
        # The configured user model is dynamic; `email` is not part of the contract.
        - '#Access to an undefined property Illuminate\\Contracts\\Auth\\Authenticatable::\$email#'

        # Inertia is an optional dependency (see the "suggest" section of
        # composer.json). The React dashboard controllers reference
        # Inertia\Inertia and Inertia\Response, which only exist when the host
        # application installs inertiajs/inertia-laravel.
        -
            message: '#Inertia#'
            path: src/Http/Controllers/Dashboard/*

        # Larastan and strict PHPStan checks
        - '#Called ''env'' outside of the config directory#'
        - '#Parameter \#1 \$view of function view expects view-string\|null#'
        - '#Parameter \#2 \$syntax of method Carbon\\Carbon::diffForHumans\(\) expects#'
        - '#Strict comparison using === between non-empty-string and ''''#'
        - '#Call to method Illuminate\\Contracts\\View\\Factory::exists\(\)#'

        # Pest tests rely on magic `$this`; the official Pest PHPStan plugin is
        # only available for Pest 5, so these are expected when tests are analysed.
        -
            message: '#Undefined variable: \$this#'
            path: tests/*
        -
            message: '#Call to an undefined method Pest\\PendingCalls\\TestCall::.*#'
            path: tests/*
